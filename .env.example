# Connection settings for the PostgreSQL database containing dbt marts.
# DATABASE_URL takes precedence over the individual DBT_* variables.
DATABASE_URL=postgresql://user:password@localhost:5432/synthetic_website_data

DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=replace-with-database-user
DBT_PASSWORD=replace-with-database-password
DBT_DATABASE=synthetic_website_data
